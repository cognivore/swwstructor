-- swwstructor depends on the stickywebwm engine (base+containers only). cabal
-- fetches it from its public GitHub repo at the same rev flake.lock pins, so a
-- plain `cabal build` and the Nix build (flake input + the checked-in cabal2nix
-- derivation, see nix/) compile the same engine. Bump both together.
packages: .

source-repository-package
  type: git
  location: https://github.com/cognivore/stickywebwm.git
  tag: c460b9a34aee503c3be94a642dba889291f1cf14

-- crypton 1.1 moved from `memory` to `ram`; the code (and nixpkgs, 1.0.x)
-- speak `memory`.
constraints: crypton < 1.1

-- Hackage's newer warp needs the threaded RTS (nixpkgs' warp does not, and the
-- Nix build ignores this file, so production is unaffected).
package swwstructor
  ghc-options: -threaded
